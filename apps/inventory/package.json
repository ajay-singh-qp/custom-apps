    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.38.0",
    "iron-session": "^8.0.0",
    "next": "^15.0.0",
    "pg": "^8.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^29.5.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "drizzle-kit": "^0.29.0",
    "jest": "^29.7.0",
    "jsdom": "^29.1.1",
    "resize-observer-polyfill": "^1.5.1",
    "testcontainers": "^12.0.0",
    "ts-node": "^10.9.2",
    "ts-jest": "^29.2.0",
    "typescript": "^5.9.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.4"
