    "test": "npm run test:be && npm run test:fe",
    "docker:smoke": "bash scripts/docker-smoke.sh"
  },
  "dependencies": {
    "@npm-questionpro/questionpro-global-oauth": "^3.7.0",
    "@npm-questionpro/wick-ui-icon": "^2.23.0",
