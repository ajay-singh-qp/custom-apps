DB_HOST=localhost
DB_PORT=5432
DB_USER=root
DB_PASSWORD=root
DB_NAME=custom_apps_dev_db

# ---------- QuestionPro OAuth ----------
# OFF by default: login is skipped and every page is public until this is
# exactly `true`. Everything below in this section (and iron-session) is only
# read when it is on. Turn it on once this app's callback URL is registered.
# QUESTIONPRO_OAUTH_ENABLED=true
# Get these from https://www.questionpro.com/a/showAdminAPISettings.do
# QUESTIONPRO_OAUTH_HOST_URL is the default data-center host; the OAuth
# flow will accept a different QP host via ?appOrigin=... on /api/oauth,
# as long as it passes QuestionProUrlValidatorUtil.isValidQuestionProUrl.
# Local dev values are placeholders — real OAuth round-trips require
# registering this app's QUESTIONPRO_OAUTH_REDIRECT_URI with QP admin.
QUESTIONPRO_OAUTH_CLIENT_ID=replace-me
QUESTIONPRO_OAUTH_HOST_URL=https://www.questionpro.com
# Must be exactly 32 bytes (AES-256-GCM).
QUESTIONPRO_OAUTH_ENCRYPTION_KEY=replace-me-32-bytes-1234567890ab
QUESTIONPRO_OAUTH_SUCCESS_REDIRECT_URL=http://localhost:3000/
QUESTIONPRO_OAUTH_REDIRECT_URI=http://localhost:3000/api/oauth/callback

# ---------- iron-session ----------
# Must be at least 32 characters. Generate: `openssl rand -hex 32`.
SESSION_PASSWORD=replace-me-with-a-random-string-at-least-32-chars-long
# Optional. Defaults to `qp_session`.
SESSION_COOKIE_NAME=qp_session
